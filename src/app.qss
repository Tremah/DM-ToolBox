QWidget {
  color: #F5F5F5;
}

QGroupBox {
  border: 1px solid #555; margin-top: 9px;
 }

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0px 1px 0px 1px;
}

QPushButton#editorToolBarButton {
  padding-top: 3;
  padding-bottom: 3;
  padding-left: 7px;
  padding-right: 7px;
}

QTextEdit#labelTextEdit {
  background: transparent;
  border: 0px solid white;;
  padding: 0px;
  margin: 0px;
  font: inherit;
}

QTextEdit#richTextEditor {
    font-family: "Consolas";
    font-size: 11;
}

QLabel {
  border: 0px solid white;
  font-family: "Ubuntu Sans";
  font-size: 16px;
  color: #F4F1EC;
}

QLineEdit {
  font-size: 16px;
}

QLabel#headerLabel {
  font-size: 18px;
}

QLabel#smallLabel {
  font-size: 12px;
}

QSpinBox {
  font-family: "Ubuntu Mono";
  font-size: 16px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #777;
    background: transparent;
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:checked {
    background-color: rgba(255, 255, 255, 0.6); /* soft white */
    width: 15px;
    height: 15px;
}

QTextEdit, QPlainTextEdit, QCheckBox, QTableWidget, QPushButton, QComboBox {
  color: #F4F1EC;
}